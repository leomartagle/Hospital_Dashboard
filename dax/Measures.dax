/*
  ==============================================================================
  Calculated Measures: Core KPIs & Performance Metrics
  ==============================================================================
*/

-- 1. Patient Volume Month-over-Month Growth Percentage
Patient Volume MoM % = 
VAR CurrentMonthVol = [Total Patients]
VAR PreviousMonthVol = 
    CALCULATE(
        [Total Patients], 
        DATEADD('Dim_Calendar'[Date], -1, MONTH)
    )
RETURN
    DIVIDE(CurrentMonthVol - PreviousMonthVol, PreviousMonthVol, 0)


-- 2. Percentage of Patients Assigned to a Case Manager
Case Manager Coverage % = 
VAR CM_Count = 
    CALCULATE(
        [Total Patients], 
        'Hospital ER Data'[Patients CM] = 1
    )
RETURN 
    DIVIDE(CM_Count, [Total Patients], 0)


-- 3. Overall Patient Admission Rate Percentage
Admission Rate % = 
VAR AdmittedCount = 
    CALCULATE(
        [Total Patients], 
        'Hospital ER Data'[Patient Admission Flag] = "Admitted"
    )
RETURN 
    DIVIDE(AdmittedCount, [Total Patients], 0)
